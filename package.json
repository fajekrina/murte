{
  "name": "murte",
  "version": "0.1.0",
  "description": "A web-native server-driven UI framework — render screens from JSON, navigate and call APIs declaratively, extend with any third-party component, with fintech-grade validation and security. The web edition of Murti.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/types/MurteCore/index.d.ts",
      "import": "./dist/murte-core.js"
    },
    "./builder": {
      "types": "./dist/types/MurteBuilder/index.d.ts",
      "import": "./dist/murte-builder.js"
    },
    "./studio": {
      "types": "./dist/types/MurteStudio/index.d.ts",
      "import": "./dist/murte-studio.js"
    },
    "./studio.css": "./dist/murte.css"
  },
  "files": [
    "dist",
    "docs/murte.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gallery": "vite --config vite.apps.config.ts --open /src/MurteGallery/",
    "studio": "vite --config vite.apps.config.ts --open /src/MurteStudio/",
    "preview-app": "vite --config vite.apps.config.ts --open /examples/MurtePreviewApp/",
    "build:apps": "vite build --config vite.apps.config.ts",
    "gen": "esbuild src/MurteGen/main.ts --bundle --platform=node --format=esm --outfile=dist/murte-gen.mjs --log-level=warning && node dist/murte-gen.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
